# Copy to .env.compose; do not reuse the local development .env.
COREMATRIX_PORT=8080
COREMATRIX_BIND_IP=0.0.0.0
# Optional fixed browser origin, e.g. http://192.0.2.10:8080; no trailing path.
# Blank uses the incoming Host for same-origin checks.
PUBLIC_ORIGIN=
INFERENCE_ALLOWED_ORIGINS=
# Optional inference credentials: INFERENCE_VLLM_KEY, INFERENCE_JUPYTER_KEY.
# 127.0.0.1 inside the API container is not the Linux host or a GPU node.
# Set these before creating the first admin; remove ADMIN_PASSWORD afterward.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=平台管理员
# Real payments/mail are disabled unless explicitly configured.
# For channel settings see .env.example and the development documents.
