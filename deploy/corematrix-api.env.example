NODE_ENV=production
API_PORT=3001
DATABASE_PATH=/var/lib/corematrix/corematrix.sqlite
PUBLIC_ORIGIN=https://console.example.invalid
TRUSTED_PROXY_IPS=127.0.0.1
# List exact inference service origins; keep secrets in INFERENCE_* variables.
INFERENCE_ALLOWED_ORIGINS=
# INFERENCE_VLLM_KEY=
# INFERENCE_JUPYTER_KEY=
# Optional real channels; blank leaves the channel disabled.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OPS_ALERT_EMAIL=
OPS_ALERT_LOCALE=zh-CN
STRIPE_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
