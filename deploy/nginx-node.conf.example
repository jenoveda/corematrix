# Include inside nginx's http block, on a GPU node separate from the console host.
# Replace NODE_IP, CONTROL_PLANE_IP and certificates; add a listen directive for every allowed port.
# Agent: COREMATRIX_INFERENCE_LOOPBACK=1 and COREMATRIX_WORKSPACE_BIND_IP=127.0.0.1.
# Register the node with an HTTPS origin. IPv6 NODE_IP in listen requires brackets.
map $http_upgrade $corematrix_connection_upgrade {
    default upgrade;
    '' close;
}
log_format corematrix_lab '$status $request_time';

server {
    listen NODE_IP:8000 ssl;
    # Example: listen NODE_IP:8001 ssl; continue through your registered portEnd.
    ssl_certificate /etc/corematrix/node.crt;
    ssl_certificate_key /etc/corematrix/node.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/corematrix-lab-access.log corematrix_lab;
    # Parsing errors precede location selection; diagnose via safe status logs and Agent codes.
    error_log /dev/null;

    location /v1/ {
        allow CONTROL_PLANE_IP;
        deny all;
        proxy_pass http://127.0.0.1:$server_port;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
        proxy_read_timeout 90s;
    }
    location /api/compute/rentals/ {
        proxy_pass http://127.0.0.1:$server_port;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";
        proxy_set_header Forwarded "";
        proxy_cookie_flags ~ secure;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $corematrix_connection_upgrade;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    location / {
        return 404;
    }
}
