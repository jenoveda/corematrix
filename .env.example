API_PORT=3001
DATABASE_PATH=data/corematrix.sqlite
# 生产 NODE_ENV=production 时必须使用持久化目录的绝对路径，例如 /var/lib/corematrix/corematrix.sqlite。
# 生产环境必填固定 HTTPS 浏览器来源；开发时可留空，由同源检查验证。
PUBLIC_ORIGIN=
# 仅填写受控反向代理连接 API 的精确 IP，逗号分隔；留空忽略所有转发头。
# 代理必须覆盖/正确追加 X-Forwarded-For；不要填写客户端网段或 0.0.0.0/0。
TRUSTED_PROXY_IPS=
# 配置模型前，列出允许访问的推理服务 origin，以逗号分隔。
INFERENCE_ALLOWED_ORIGINS=http://127.0.0.1:8000
# 密钥仅由服务器读取，前端只填写变量名。
# INFERENCE_VLLM_KEY=
# 设置以下值后运行 npm run create-admin；创建后可移除 ADMIN_PASSWORD。
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=平台管理员
# Jupyter workspace master key: same value as node environment, >=32 random characters.
# INFERENCE_JUPYTER_KEY=
# SMTP 开启后 PUBLIC_ORIGIN 必填固定站点 origin；生产必须 HTTPS。
# 未配置 SMTP_HOST 时禁用发信，不伪造发送成功。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Stripe：不配置 SECRET_KEY 时禁用支付；须配置固定 PUBLIC_ORIGIN。
# test/live 必须与密钥模式一致；Webhook 使用本平台的 Snapshot 事件端点密钥。
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 运维新告警/恢复摘要；留空时仅在管理台记录，不发信。
# 需同时配置 SMTP。语言支持 zh-CN / en-US / ja-JP / ko-KR。
OPS_ALERT_EMAIL=
OPS_ALERT_LOCALE=zh-CN
