# Use a real reachable HTTPS control plane, never commit the completed file.
COREMATRIX_URL=https://control.example.com
COREMATRIX_AGENT_TOKEN=node_REPLACE_WITH_ONE_TIME_TOKEN
COREMATRIX_RUNTIME_IMAGE=vllm/vllm-openai@sha256:REPLACE_WITH_VERIFIED_DIGEST
COREMATRIX_MODEL_DIR=/opt/corematrix/models
COREMATRIX_CACHE_DIR=/var/cache/corematrix
COREMATRIX_AGENT_STATE_DIR=/var/lib/corematrix-agent
# Set after testing shared-memory needs for the chosen model and GPU topology.
COREMATRIX_SHM_SIZE=8g
# Set to 1 for a TLS proxy shared by inference and Jupyter; blank/0 preserves the old binding.
# Drain existing containers before changing this; old containers keep their original bindings.
COREMATRIX_INFERENCE_LOOPBACK=
# Third-party nodes require scoped mode; credentials arrive through authenticated heartbeat.
COREMATRIX_NODE_SCOPED_KEYS=1
# Legacy self-owned nodes with mode 0 need matching INFERENCE_* secrets on both ends.
INFERENCE_NODE_KEY=REPLACE_WITH_RANDOM_SECRET

# Optional JupyterLab runtime, required for GPU rental mode.
# Leave COREMATRIX_RUNTIME_IMAGE empty on rental-only nodes.
COREMATRIX_WORKSPACE_IMAGE=
COREMATRIX_WORKSPACE_DIR=/var/lib/corematrix-workspaces
COREMATRIX_WORKSPACE_KEY_ENV=INFERENCE_JUPYTER_KEY
# Configure this same random value on the control plane (at least 32 characters).
INFERENCE_JUPYTER_KEY=
# Loopback is for a TLS proxy on the node's external IP; private testing may use 0.0.0.0.
COREMATRIX_WORKSPACE_BIND_IP=127.0.0.1
COREMATRIX_WORKSPACE_CPUS=4
COREMATRIX_WORKSPACE_MEMORY_MIB=16384
